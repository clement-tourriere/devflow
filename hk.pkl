amends "package://github.com/jdx/hk/releases/download/v2.5.0/hk@2.5.0#/Config.pkl"

// `hk install` once per clone (`hk install --mise` if mise is not activated in
// your shell).

local rust = new Mapping<String, Step> {
    ["cargo-fmt"] {
        glob = "**/*.rs"
        check = "cargo fmt --check"
        fix = "cargo fmt"
    }
    // The CLI and core; CI lints the desktop app on macOS.
    ["cargo-clippy"] {
        glob = "**/*.rs"
        check = "cargo clippy --locked --all-targets -- -D warnings"
        fix = "cargo clippy --locked --all-targets --fix --allow-dirty --allow-staged -- -D warnings"
    }
}

// `hk check` and `hk fix`.
steps {
    ...rust
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps {
            ...rust
        }
    }
}
